<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests every catalog model on every device of this computer (NPU, GPU, CPU) with real requests.
       Windows only; downloads missing models. Run model_tests.bat (options are listed there). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>KeyboardSwitcher</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\KeyboardSwitcher\AiCorrector.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\AiPlatform.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\AiSetup.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\AmdSupport.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\LlmBackend.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\OpenVinoGenAI.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\Loc.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\Layouts.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\Settings.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\Native.cs" />
    <Compile Include="..\..\src\KeyboardSwitcher\ChatStore.cs" />
    <EmbeddedResource Include="..\..\src\KeyboardSwitcher\Resources\Strings.tsv" LogicalName="KeyboardSwitcher.Resources.Strings.tsv" />
  </ItemGroup>
</Project>
